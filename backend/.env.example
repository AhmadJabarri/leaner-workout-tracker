# Copy this file to .env and replace the values with your local PostgreSQL settings.
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/leaner
# Set to true when serving the app over HTTPS; keep false for local HTTP development.
AUTH_COOKIE_SECURE=false
# Create a key in GroqCloud and keep the real key in backend/.env or Koyeb settings.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
